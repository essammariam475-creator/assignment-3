void CountGeneral(List<int> arr) {
  List<int> checked = [];

  for (int i = 0; i < arr.length; i++) {
    if (!checked.contains(arr[i])) {
      int count = 0;

      for (int j = 0; j < arr.length; j++) {
        if (arr[i] == arr[j]) {
          count++;
        }
      }

      print("${arr[i]} appears $count times");
      checked.add(arr[i]);
    }
  }
}

void main() {
  CountGeneral([1, 2, 2, 3, 1, 2]);
}