void getDistinctNumbers(List<int> arr) {
  List<int> distinct = [];

  for (int i = 0; i < arr.length; i++) {
    if (!distinct.contains(arr[i])) {
      distinct.add(arr[i]);
    }
  }

  print("Number of distinct numbers: ${distinct.length}");
  print(distinct.join(" "));
}

void main() {
  getDistinctNumbers([1, 2, 2, 3, 4, 4, 5]);
}