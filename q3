void containsValue(List<int> arr, int target) {
  bool found = false;

  for (int i = 0; i < arr.length; i++) {
    if (arr[i] == target) {
      found = true;
      break;
    }
  }

  if (found) {
    print("Yes");
  } else {
    print("No");
  }
}

void main() {
  containsValue([1, 5, 8, 3], 5);
}